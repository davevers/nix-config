# name: Everforest Hard
# url: https://github.com/sainnhe/everforest
# Fish 4.3+; automatic light/dark selection based on terminal appearance.

[dark]
# preferred_background: 272e33
# Everforest Dark Hard
fish_color_normal D3C6AA
fish_color_command A7C080
fish_color_keyword E67E80
fish_color_quote 83C092
fish_color_redirection E69875
fish_color_end E69875
fish_color_error E67E80 --bold
fish_color_param D3C6AA
fish_color_option 7FBBB3
fish_color_comment 859289
fish_color_operator E69875
fish_color_escape DBBC7F
fish_color_autosuggestion 7A8478
fish_color_valid_path --underline
fish_color_selection D3C6AA --background=4C3743
fish_color_search_match D3C6AA --background=45443C
fish_color_history_current --bold
fish_color_cancel --reverse
fish_color_cwd 7FBBB3
fish_color_cwd_root E67E80
fish_color_user A7C080
fish_color_host D3C6AA
fish_color_host_remote DBBC7F
fish_color_status E67E80
fish_pager_color_background --background=272E33
fish_pager_color_prefix A7C080 --bold
fish_pager_color_completion D3C6AA
fish_pager_color_description 859289
fish_pager_color_progress DBBC7F --background=374145
fish_pager_color_selected_background --background=414B50
fish_pager_color_selected_prefix A7C080 --bold
fish_pager_color_selected_completion D3C6AA
fish_pager_color_selected_description 9DA9A0
fish_pager_color_secondary_background --background=2E383C

