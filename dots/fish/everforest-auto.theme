fish_color_operator F57D26
fish_color_escape DFA000
fish_color_autosuggestion A6B0A0
fish_color_valid_path --underline
fish_color_selection 5C6A72 --background=F0F2D4
fish_color_search_match 5C6A72 --background=FEF2D5
fish_color_history_current --bold
fish_color_cancel --reverse
fish_color_cwd 3A94C5
fish_color_cwd_root F85552
fish_color_user 8DA101
fish_color_host 5C6A72
fish_color_host_remote F57D26
fish_color_status F85552
fish_pager_color_background --background=FFFBEF
fish_pager_color_prefix 8DA101 --bold
fish_pager_color_completion 5C6A72
fish_pager_color_description 829181
fish_pager_color_progress 5C6A72 --background=F3F5D9
fish_pager_color_selected_background --background=EDEADA
