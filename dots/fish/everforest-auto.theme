[unknown]
# When the terminal cannot report its appearance, use terminal ANSI colors.
fish_color_normal --reset
fish_color_command green
fish_color_keyword red
fish_color_quote green
fish_color_redirection yellow
fish_color_end yellow
fish_color_error red --bold
fish_color_param --reset
fish_color_option cyan
fish_color_comment brblack
fish_color_operator yellow
fish_color_escape yellow
fish_color_autosuggestion brblack
fish_color_valid_path --underline
fish_color_selection --reverse
fish_color_search_match --reverse
fish_color_history_current --bold
fish_color_cancel --reverse
fish_color_cwd cyan
fish_color_cwd_root red
fish_color_user green
fish_color_host --reset
fish_color_host_remote yellow
fish_color_status red
fish_pager_color_prefix green --bold
fish_pager_color_completion --reset
fish_pager_color_description brblack
fish_pager_color_progress yellow
fish_pager_color_selected_background --reverse
